# ==============================================================================
# FerrousCX Master Environment Configuration Template
# Adheres strictly to Secret Zero, AD-24 (Day-0 Defense), and AD-29 (Pinned Bridge Image)
# ==============================================================================

# --- Bridge Service Configuration (AD-29) ---
# NOTE: Under AD-29, BRIDGE_IMAGE must be pinned to a submodule short commit SHA, never 'latest'.
BRIDGE_IMAGE=iggy-kafka-bridge:0f8d788
BRIDGE_IGGY_USERNAME=svc_kafka_bridge
BRIDGE_IGGY_PASSWORD=development_secret_bridge_password_32b!

# --- Apache Iggy & Streaming Service Configuration ---
STREAMING_SERVICE_ACCOUNT=svc_ferrous_streaming
IGGY_SERVER_ADDRESS=iggy-broker:8090
IGGY_USERNAME=iggy
IGGY_PASSWORD=iggy
IGGY_HTTP_JWT_ENCODING_SECRET=development_jwt_encoding_secret_minimum_32_bytes_long!
IGGY_HTTP_JWT_DECODING_SECRET=development_jwt_encoding_secret_minimum_32_bytes_long!

# --- Kanidm IdP (ferrous-iam) Authentication ---
KANIDM_JWT_SECRET=development_kanidm_jwt_secret_32_bytes_minimum!
KANIDM_ISSUER=https://iam.ferrouscx.local/oauth2/openid/svc_ferrous_api

# --- AI & LLM Engine (ferrous-agent) Configuration ---
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_API_BASE=http://host.docker.internal:11434
LLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=

# --- OpenTelemetry 3-Tier Observability (AD-23) ---
# Tier 1: Local / CI minimal stdout (OTEL_SDK_DISABLED=true)
# Tier 2: Diagnostic console streaming (OTEL_SDK_DISABLED=false, OTEL_TRACES_EXPORTER=console)
# Tier 3: OTLP export into ephemeral Jaeger (OTEL_SDK_DISABLED=false, OTEL_TRACES_EXPORTER=otlp)
#   - gRPC standard (port 4317): OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
#   - HTTP REST (port 4318):     OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SDK_DISABLED=true
OTEL_TRACES_EXPORTER=console
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# --- Ingress Ports ---
PORT_HTTP=80
PORT_HTTPS=443
PORT_FRONTEND=5173
PORT_API=8080
PORT_AGENT=8081
PORT_IAM=8443
PORT_VECTORDB=6333
PORT_IGGY=8090
PORT_KAFKA=9092
PORT_OTLP_GRPC=4317
PORT_OTLP_HTTP=4318
PORT_JAEGER_UI=16686
PORT_SIERRADB=9090

# --- Enterprise Saga Settlement Configuration (Story 18.2, Story 18.3) ---
# Destination endpoint for outbound settlement dispatches (ERP mock or ferrous-api webhook gateway)
ENTERPRISE_SETTLEMENT_URL=http://ferrous-api:8080/api/v1/webhooks/orders/settlement-callback
ENTERPRISE_AUTH_TOKEN=

