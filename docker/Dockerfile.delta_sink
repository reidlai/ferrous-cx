# syntax=docker/dockerfile:1.4
# Hardened rootless FROM scratch container build for ferrous-cx delta-sink daemon
# Adheres strictly to AD-24 (UID 10001, static musl, Day-0 defense)

FROM rust:1.99-alpine AS builder

RUN apk add --no-cache musl-dev gcc make ca-certificates

WORKDIR /usr/src/ferrous-cx

RUN echo "ferrous:x:10001:10001:FerrousCX Delta Sink:/nonexistent:/sbin/nologin" > /etc/passwd.scratch && \
    echo "ferrous:x:10001:" > /etc/group.scratch && \
    mkdir -m 1777 /tmp_scratch && \
    mkdir -p /data_delta_scratch

COPY Cargo.toml Cargo.lock ./
COPY src/ ./src/

ENV RUSTFLAGS="-C target-feature=+crt-static"
RUN rustup target add x86_64-unknown-linux-musl && \
    cargo build --release --locked --target x86_64-unknown-linux-musl --bin delta-sink

FROM scratch

LABEL org.opencontainers.image.title="ferrous-delta-sink" \
      org.opencontainers.image.description="Hardened rootless Apache Iggy to Delta Lake 2PC sink daemon for FerrousCX" \
      org.opencontainers.image.version="0.1.0" \
      org.opencontainers.image.vendor="FerrousCX" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0"

COPY --from=builder /etc/passwd.scratch /etc/passwd
COPY --from=builder /etc/group.scratch /etc/group
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /tmp_scratch /tmp
COPY --from=builder --chown=10001:10001 /data_delta_scratch /data/delta
COPY --from=builder /usr/src/ferrous-cx/target/x86_64-unknown-linux-musl/release/delta-sink /delta-sink

USER 10001:10001

EXPOSE 8095

HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
  CMD ["/delta-sink", "--healthcheck"]

ENTRYPOINT ["/delta-sink"]
CMD []
