# syntax=docker/dockerfile:1.4
# Hardened rootless FROM scratch container build for ferrous-cx tidb-sink daemon (Story 23.2)
# Adheres strictly to AD-24 (UID 10001, static musl, pure-Rust sqlx + rustls, Day-0 defense)

FROM rust:1.98-alpine AS builder

RUN apk add --no-cache musl-dev gcc make ca-certificates

WORKDIR /usr/src/ferrous-cx

RUN echo "ferrous:x:10001:10001:FerrousCX TiDB Sink:/nonexistent:/sbin/nologin" > /etc/passwd.scratch && \
    echo "ferrous:x:10001:" > /etc/group.scratch && \
    mkdir -m 1777 /tmp_scratch

COPY Cargo.toml Cargo.lock ./
COPY config/ ./config/
COPY src/ ./src/

ENV RUSTFLAGS="-C target-feature=+crt-static"
RUN rustup target add x86_64-unknown-linux-musl && \
    cargo build --release --target x86_64-unknown-linux-musl --bin tidb-sink

FROM scratch

LABEL org.opencontainers.image.title="ferrous-tidb-sink" \
      org.opencontainers.image.description="Hardened rootless Apache Iggy to TiDB transactional sink daemon for FerrousCX" \
      org.opencontainers.image.version="0.1.0" \
      org.opencontainers.image.vendor="FerrousCX" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0"

COPY --from=builder /etc/passwd.scratch /etc/passwd
COPY --from=builder /etc/group.scratch /etc/group
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /tmp_scratch /tmp
COPY --from=builder /usr/src/ferrous-cx/target/x86_64-unknown-linux-musl/release/tidb-sink /tidb-sink

USER 10001:10001

EXPOSE 8095

HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
  CMD ["/tidb-sink", "--healthcheck"]

ENTRYPOINT ["/tidb-sink"]
CMD []
